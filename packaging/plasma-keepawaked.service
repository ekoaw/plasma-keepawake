[Unit]
Description=Rule-driven sleep inhibitor for KDE Plasma
# Needs the session D-Bus bus (MPRIS/logind calls) and a running Plasma
# session (this is a desktop tool, not something that makes sense headless).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Installed via the PKGBUILD in this directory, which puts the binary at
# /usr/bin. If you instead built it with `cargo install --path daemon
# --root ~/.local`, change this to %h/.local/bin/plasma-keepawaked.
ExecStart=/usr/bin/plasma-keepawaked --run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
