[Unit]
Description=Rule-driven sleep inhibitor for KDE Plasma
Documentation=https://github.com/eko-adi-wicaksono/plasma-keepawake
# Needs the session D-Bus bus (MPRIS/logind calls) and a running Plasma
# session (this is a desktop tool, not something that makes sense headless).
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
# Adjust if installed elsewhere - `cargo install --path daemon --root ~/.local`
# puts the binary at %h/.local/bin/plasma-keepawaked. A PKGBUILD (milestone 8,
# still pending) would install to /usr/bin instead.
ExecStart=%h/.local/bin/plasma-keepawaked --run
Restart=on-failure
RestartSec=5

[Install]
WantedBy=graphical-session.target
